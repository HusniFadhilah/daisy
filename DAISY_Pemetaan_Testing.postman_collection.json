{
	"info": {
		"_postman_id": "daisy-pemetaan-testing",
		"name": "DAISY - Pemetaan Akreditasi Testing",
		"description": "Collection untuk testing API Pemetaan Akreditasi tanpa autentikasi.\n\n**Base URL:** http://127.0.0.1:8000\n\n**Endpoint:**\n- GET /api/test/pemetaan/stats - Statistik keseluruhan\n- GET /api/test/pemetaan/timeline/{periode} - Timeline data\n- GET /api/test/pemetaan/calendar - Calendar 12 bulan\n- GET /api/test/pemetaan/programs - List programs dengan filter",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Get Statistik Keseluruhan",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time is less than 500ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(500);",
							"});",
							"",
							"pm.test(\"Success is true\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"});",
							"",
							"pm.test(\"Data contains total_program_studi\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.total_program_studi).to.exist;",
							"});",
							"",
							"pm.test(\"Status breakdown exists\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.status.aktif).to.exist;",
							"    pm.expect(jsonData.data.status.kedaluwarsa).to.exist;",
							"    pm.expect(jsonData.data.status.belum_terakreditasi).to.exist;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/test/pemetaan/stats",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"test",
						"pemetaan",
						"stats"
					]
				},
				"description": "Mendapatkan statistik keseluruhan program studi:\n- Total program studi\n- Status (Aktif, Kedaluwarsa, Belum Terakreditasi)\n- Segera kedaluwarsa (3, 6, 12 bulan)\n- Breakdown by peringkat\n- Persentase masing-masing status"
			},
			"response": []
		},
