@startuml Daisy_User_ProgramStudi
title Daisy - User, Role, University, Program Studi
skinparam classAttributeIconSize 0
hide circle

package "Models" {
  class User {
    +id
    +name
    +email
    +role
    +id_university
    +id_study_program
    +hasRole(role)
    +syncRolesFromAssignments()
    +switchRole(roleName)
