@startuml Daisy_UC_Lengkap_Satu_Diagram
title Daisy - Use Case Diagram Lengkap

left to right direction
scale max 3600x2400
skinparam dpi 120
skinparam pageMargin 12
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontSize 9
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #424242
}

actor "Semua\nPengguna" as All
actor "Semua Pengguna\nTerdaftar" as Reg
actor "Pengguna\nMulti-Role" as Multi
actor "Superadmin" as SA
actor "Sekretariat /\nDE" as Sek
actor "Prodi /\nUPPS" as Prodi
actor "Keuangan" as Keu
actor "Validator" as Val
actor "Asesor" as Asesor
actor "Asesor\nBanding" as AB
actor "Sistem" as Sys
actor "Semua\nAktor" as Semua

rectangle "Sistem Akreditasi Daisy" {
  package "1. Manajemen Akun" {
    usecase "Login ke Sistem" as UC01
    usecase "Logout dari Sistem" as UC02
    usecase "Reset Kata Sandi" as UC03
    usecase "Ubah Kata Sandi" as UC04
    usecase "Lihat & Perbarui Profil" as UC05
    usecase "Switch Role" as UC06
  }

  package "2. Kelola Pengguna" {
    usecase "Kelola Pengguna" as UC07
  }

  package "3. Master Data" {
    usecase "Kelola Data Master" as UC08
  }

  package "4. Pengingat Masa Akreditasi" {
    usecase "Pengingat Masa\nAkreditasi" as UC09
  }

  package "5. Permohonan Akreditasi" {
    usecase "Buat & Kirim\nPermohonan" as UC10
  }

  package "6. Penerimaan Permohonan" {
    usecase "Tinjau Permohonan" as UC11
    usecase "Terima Permohonan" as UC12
    usecase "Permintaan Upload\nUlang" as UC13
  }

  package "7. Pembayaran" {
    usecase "Kirim Invoice\n& Template" as UC14
    usecase "Upload Bukti\nPembayaran" as UC15
    usecase "Validasi Pembayaran" as UC16
  }

  package "8. Pengiriman Dokumen" {
    usecase "Upload Dokumen\nAkreditasi" as UC17
    usecase "Finalisasi Dokumen" as UC18
  }

  package "9. Validasi Dokumen" {
    usecase "Validasi Dokumen" as UC19
    usecase "Permintaan Revisi" as UC20
    usecase "Upload Revisi" as UC21
  }

  package "10. Pelaporan Validasi" {
    usecase "Pelaporan Validasi\nDokumen" as UC22
  }

  package "11. Asesmen Kecukupan (AK)" {
    usecase "Penilaian AK" as UC23
    usecase "Deteksi Split\nPenilaian" as UC24
    usecase "Validasi AK" as UC25
  }

  package "12. Pelaporan AK" {
    usecase "Pelaporan AK" as UC26
  }

  package "13. Asesmen Lapangan (AL)" {
    usecase "Penilaian AL" as UC27
    usecase "Berita Acara AL" as UC28
  }

  package "14. Laporan Hasil Asesmen (LHA)" {
    usecase "Susun & Finalisasi\nLHA" as UC29
    usecase "Review & Persetujuan\nLHA" as UC30
  }

  package "15. Ringkasan Akreditasi" {
    usecase "Susun Ringkasan" as UC31
  }

  package "16. Pelaporan AL" {
    usecase "Pelaporan AL" as UC32
  }

  package "17. Penyampaian Hasil" {
    usecase "Penyampaian Hasil" as UC33
  }

  package "18. Masa Sanggah" {
    usecase "Masa Sanggah" as UC34
  }

  package "19. Permohonan Banding" {
    usecase "Unduh Template" as UC35
    usecase "Isi & Upload\nBanding" as UC36
    usecase "Kirim Banding" as UC37
    usecase "Monitoring Status" as UC38
  }

  package "20. Pelaksanaan Banding" {
    usecase "Pembayaran Banding" as UC39
    usecase "Penugasan Asesor" as UC40
    usecase "Penilaian AK\nBanding" as UC44
    usecase "Penilaian AL\nBanding" as UC45
    usecase "Persetujuan\nLaporan" as UC46
  }

  package "21. Pelaporan Banding" {
    usecase "Pelaporan Banding" as UC47
  }

  package "22. Penetapan Hasil" {
    usecase "Penetapan Hasil" as UC41
  }

  package "23. Arsip" {
    usecase "Pengarsipan\nAkreditasi" as UC43
  }

  package "24. Monitoring" {
    usecase "Monitoring Sistem" as UC42
  }
}

