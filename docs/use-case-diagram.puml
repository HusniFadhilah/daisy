@startuml Daisy_UC_Overview
title Daisy Use Case - Overview Modul Utama
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Pengunjung" as Guest
actor "Pengguna\nTerautentikasi" as AuthUser
actor "Super Admin" as SuperAdmin
actor "Sekretariat / DE" as DE
actor "Admin Prodi / UPPS" as Prodi
actor "Keuangan" as Finance
actor "Asesor" as Asesor
actor "Asesor Banding" as AsesorBanding
actor "Validator" as Validator

rectangle "Sistem DAISY" {
  usecase "Akses & Profil" as UC_Access
  usecase "Pengajuan\nAkreditasi" as UC_Application
  usecase "Pembayaran &\nValidasi Dokumen" as UC_DocumentPayment
  usecase "Penugasan\nAsesmen" as UC_Assignment
  usecase "Asesmen\nAK/AL" as UC_Assessment
  usecase "Banding" as UC_Appeal
  usecase "Hasil & Arsip" as UC_ResultArchive
  usecase "Master Data &\nAdministrasi" as UC_Admin
}

Guest --> UC_Access
AuthUser --> UC_Access
Prodi --> UC_Application
DE --> UC_Application
Finance --> UC_DocumentPayment
Validator --> UC_DocumentPayment
DE --> UC_Assignment
Asesor --> UC_Assessment
Validator --> UC_Assessment
Prodi --> UC_Appeal
AsesorBanding --> UC_Appeal
DE --> UC_ResultArchive
Prodi --> UC_ResultArchive
SuperAdmin --> UC_Admin

@enduml

@startuml Daisy_UC_Akses_Profil_Admin
title Daisy Use Case - Akses, Profil, Administrasi
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Pengunjung" as Guest
actor "Pengguna\nTerautentikasi" as AuthUser
actor "Super Admin" as SuperAdmin
actor "Sekretariat / DE" as DE

rectangle "Sistem DAISY" {
  package "Akses & Profil" {
    usecase "Login" as UC_Login
    usecase "Reset Password" as UC_ResetPassword
    usecase "Pilih / Ganti Role" as UC_SwitchRole
    usecase "Kelola Profil" as UC_Profile
    usecase "Kelola Email Profil" as UC_ProfileEmail
    usecase "Lihat Dashboard" as UC_Dashboard
    usecase "Lihat Notifikasi" as UC_Notification
  }

  package "Master Data & Administrasi" {
    usecase "Kelola User" as UC_ManageUsers
    usecase "Kelola Universitas" as UC_ManageUniversity
    usecase "Kelola Program Studi" as UC_ManageStudyProgram
    usecase "Kelola Instrumen\nPenilaian" as UC_ManageInstrument
    usecase "Kelola Bobot dan\nSyarat Akreditasi" as UC_ManageWeights
    usecase "Preview Email\nNotifikasi" as UC_EmailPreview
  }
}

Guest --> UC_Login
Guest --> UC_ResetPassword
AuthUser --> UC_Dashboard
AuthUser --> UC_SwitchRole
AuthUser --> UC_Profile
AuthUser --> UC_ProfileEmail
AuthUser --> UC_Notification
SuperAdmin --> UC_ManageUsers
SuperAdmin --> UC_ManageUniversity
SuperAdmin --> UC_ManageStudyProgram
SuperAdmin --> UC_ManageInstrument
SuperAdmin --> UC_ManageWeights
DE --> UC_EmailPreview
SuperAdmin --> UC_EmailPreview

@enduml

@startuml Daisy_UC_Pengajuan_Validasi_Awal
title Daisy Use Case - Pengajuan, Borang, Validasi Awal
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Admin Universitas" as AdminUniv
actor "Admin Prodi / UPPS" as Prodi
actor "Sekretariat / DE" as DE
actor "Validator" as Validator

rectangle "Sistem DAISY" {
  package "Pengajuan Akreditasi" {
    usecase "Lihat Pemetaan\nAkreditasi" as UC_Mapping
    usecase "Ajukan Permohonan\nAkreditasi" as UC_SubmitApplication
    usecase "Unduh Template\nBorang" as UC_DownloadTemplate
    usecase "Upload Surat / Dokumen\nPermohonan" as UC_UploadApplicationDocs
    usecase "Upload Draft Borang" as UC_UploadDraftBorang
    usecase "Isi / Import Borang\nLKPS" as UC_ManageBorang
    usecase "Kirim Revisi Borang" as UC_ReviseBorang
    usecase "Lihat Status\nPengajuan" as UC_ViewApplicationStatus
  }

  package "Validasi Awal" {
    usecase "Kirim Pengingat\nAkreditasi" as UC_SendReminder
    usecase "Terima Permohonan" as UC_ReceiveApplication
    usecase "Kirim Template" as UC_SendTemplate
    usecase "Review dan Validasi\nDokumen" as UC_ValidateDocs
    usecase "Minta Revisi\nBorang/Dokumen" as UC_RequestRevision
    usecase "Setujui Borang\nFinal" as UC_ApproveFinalBorang
  }
}

AdminUniv --> UC_Mapping
AdminUniv --> UC_ViewApplicationStatus
Prodi --> UC_Mapping
Prodi --> UC_SubmitApplication
Prodi --> UC_DownloadTemplate
Prodi --> UC_UploadApplicationDocs
Prodi --> UC_UploadDraftBorang
Prodi --> UC_ManageBorang
Prodi --> UC_ReviseBorang
Prodi --> UC_ViewApplicationStatus
DE --> UC_SendReminder
DE --> UC_ReceiveApplication
DE --> UC_SendTemplate
DE --> UC_RequestRevision
DE --> UC_ApproveFinalBorang
Validator --> UC_ValidateDocs
UC_SubmitApplication ..> UC_DownloadTemplate : <<include>>
UC_UploadDraftBorang ..> UC_ManageBorang : <<include>>
UC_ReviseBorang ..> UC_RequestRevision : <<extend>>

@enduml

